{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "linux-backup-gui",
  "version": "0.1.0",
  "identifier": "tools.linux-backup.gui",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "linux-backup",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
